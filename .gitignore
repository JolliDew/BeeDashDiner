# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Local environment and secrets (never commit these)
gamefile/db.php
gamefile/src/google-config.php
.env
.env.*

# User uploads are runtime data, not source.
gamefile/uploads/*
!gamefile/uploads/.htaccess
!gamefile/uploads/.gitkeep

# Dependency folders (not used yet, but keeps future tooling out)
node_modules/

# The game ships its small front-end libraries in gamefile/vendor so it can run
# offline under XAMPP. Do not ignore that folder.
